diff --git a/vllm_gguf_plugin/weights_adapter/gemma4.py b/vllm_gguf_plugin/weights_adapter/gemma4.py
index 6d61e2a..4468e35 100644
--- a/vllm_gguf_plugin/weights_adapter/gemma4.py
+++ b/vllm_gguf_plugin/weights_adapter/gemma4.py
@@ -183,5 +183,56 @@ class Gemma4GGUFAdapter(BaseGGUFWeightsAdapter):
         del model_config
         for name, weight in weights:
             if name == "model.vision_tower.patch_embedder.input_proj.weight":
+                if weight.ndim == 4:
+                    # GGUF convolution is OIHW; the processor emits HWC patches.
+                    weight = weight.permute(0, 2, 3, 1).contiguous()
                 weight = weight.flatten(1)
             yield from self._split_expert_weights(name, weight)
+
+
+class Gemma4MtpGGUFAdapter(BaseGGUFWeightsAdapter):
+    """Load a standalone Gemma 4 assistant GGUF through native MTP execution.
+
+    Assistant attention has Q projections only; its K/V cache is supplied by
+    the target model. The assistant embedding is retained for its own output
+    head while vLLM shares the target embedding for draft inputs.
+    """
+
+    @classmethod
+    def matches(cls, config) -> bool:
+        return config.model_type in ("gemma4_assistant", "gemma4_mtp")
+
+    @classmethod
+    def architecture(cls, config) -> str:
+        return "Gemma4MTPModel"
+
+    @staticmethod
+    def map_name(name: str) -> str | None:
+        mapper = WeightsMapper(
+            orig_to_new_prefix={
+                "token_embd.": "model.embed_tokens.",
+                "blk.": "model.layers.",
+                "output_norm.": "model.norm.",
+                "output.": "lm_head.",
+                "nextn.pre_projection.": "pre_projection.",
+                "nextn.post_projection.": "post_projection.",
+            },
+            orig_to_new_substr=GEMMA4_TEXT_SUBSTR,
+        )
+        return _map_tensor_name(mapper, name)
+
+    def build_name_map(
+        self,
+        files: GGUFModelFiles,
+        model_config: ModelConfig,
+    ) -> dict[str, str]:
+        del model_config
+        names = sorted(get_gguf_tensor_names(files.backbone))
+        mapping = {}
+        for name in names:
+            mapped = self.map_name(name)
+            if mapped is not None:
+                mapping[name] = mapped
+            elif name != "rope_freqs.weight":
+                raise ValueError(f"Unmapped Gemma 4 assistant tensor: {name}")
+        return mapping
