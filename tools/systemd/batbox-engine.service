[Unit]
Description=BatBox autonomous engine on the local model backend
Wants=batbox-memory.service batbox-api.service
After=batbox-memory.service batbox-api.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/batbox
EnvironmentFile=%h/.batbox/engine.env
ExecStart=%h/.local/lib/batbox-engine/current/batbox --autonomous --env %h/.batbox/engine.env --engine-project-root %h/batbox --engine-state-dir %h/.batbox/autonomous --engine-letter-file %h/love_letters.txt --engine-interval 60
ExecStopPost=/usr/bin/python3 %h/batbox/tools/engine_supervisor.py record
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
